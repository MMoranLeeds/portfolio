{
  "name": "matthew-moran-portfolio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build && vite build --ssr src/entry-server.ts --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run build",
    "images:optimise": "node scripts/optimise-images.mjs",
    "images:watch": "node scripts/optimise-images.mjs --watch",
    "predev": "npm run images:optimise",
    "prebuild": "npm run images:optimise",
    "pretype-check": "npm run images:optimise",
    "test:static": "node scripts/verify-static.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "transcript:generate": "node scripts/transcripts.mjs generate",
    "transcript:publish": "node scripts/transcripts.mjs publish"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
